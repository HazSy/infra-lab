# Copia a .env y cambia los secretos.
# `make up` falla a propósito si falta alguno de los obligatorios.

# --- Base de datos ---
POSTGRES_DB=billing
POSTGRES_USER=billing
POSTGRES_PASSWORD=cambia-esta-clave-de-postgres

# --- API ---
# 32 bytes mínimo (HS256)
JWT_SECRET=cambia-esta-clave-de-firma-de-al-menos-32-bytes

# Ruta al repositorio de la API (por defecto, hermano de este)
# API_CONTEXT=../billing-api

# --- Proxy ---
HTTP_PORT=8080

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambia-esta-clave-de-grafana
